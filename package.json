{
  "name": "ayukhno.github.io",
  "version": "1.4.0",
  "private": true,
  "description": "Personal website of Oleksandr Yukhno: an online CV in Ukrainian and English, static and dependency-free, published with GitHub Pages.",
  "homepage": "https://ayukhno.github.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayukhno/ayukhno.github.io.git"
  },
  "license": "MIT",
  "author": "Oleksandr Yukhno",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "check": "node --check dist/story.js && node --check server.mjs",
    "lint:html": "html-validate dist",
    "lint:css": "stylelint \"dist/**/*.css\"",
    "test": "npm run check && npm run lint:html && npm run lint:css"
  },
  "devDependencies": {
    "html-validate": "11.16.2",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  }
}
